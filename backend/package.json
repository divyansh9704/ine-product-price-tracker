{
  "name": "product-price-tracker-backend",
  "version": "1.0.0",
  "description": "Backend API and resilient scraper for Product Price Tracker",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
