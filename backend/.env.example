# Backend Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Supabase Postgres Configuration (Free Tier)
# Found in Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Cron Job Secret
# Header x-cron-secret must match this value (compared in constant time)
CRON_SECRET=generate-a-secure-random-secret-key

# CORS Configuration
# Set to your frontend deployment URL (or localhost during development)
FRONTEND_ORIGIN=http://localhost:5173

# Target Mock Store (Hard constraint: ONLY demo.inelabteamdev.com)
STORE_BASE_URL=https://demo.inelabteamdev.com

# Optional Bonus: Email alerts via SendGrid (Leave empty if not using)
SENDGRID_API_KEY=
ALERT_EMAIL_TO=
